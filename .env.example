# Database (leave unset to use the local SQLite database)
DATABASE_URL=sqlite:///./meal_planner.db

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email (configure only when email features are enabled)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_sender@example.com
SMTP_USE_TLS=true

# Application
FRONTEND_URL=http://localhost:3000

# Recipe/ingredient classification
GROQ_API_KEY=your_groq_api_key_here